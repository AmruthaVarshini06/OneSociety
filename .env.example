# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000

# MongoDB Atlas – use a DEV database, never production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/onesociety_dev?retryWrites=true&w=majority
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Idempotency
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# ─── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase / FCM ───────────────────────────────────
# Set FCM_ENABLED=true only in production or when you want real pushes
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── WhatsApp / SMS (always mocked in dev) ────────────
WHATSAPP_ENABLED=false
SMS_ENABLED=false

# ─── Mobile (Expo public vars) ────────────────────────
# Put these in apps/mobile/.env or use app.config.js extra
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
